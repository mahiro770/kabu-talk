rules_version = '2';

// 匿名株予想チャットアプリ（カブトーク） Firestoreセキュリティルール
// design.md 3章（API設計）・7章（NGワード）・8章（例外系）に基づく想定案。
//
// 【開発担当からの申し送り】
// design.md 3-4章に明記の通り、通報時のトランザクション（reportCount整合性・exists()による重複防止）は
// 実プロジェクト（Firebase Emulator Suite）での検証が必須である。本リポジトリには実際のFirebase
// プロジェクトが存在しないため、ルール自体は「想定案」として design.md の記述どおりに実装した。
// 社長がFirebaseプロジェクトを作成した後、必ず以下のいずれかの方法で検証すること（SETUP.md参照）：
//   1. `firebase emulators:start` でこのルールをロードし、通報の連続実行・重複通報・改ざんクライアントを模した
//      不正リクエストが期待通り拒否/許可されるかを確認する
//   2. もし reportCount のトランザクション整合性チェックが意図通り動かない場合は、design.md 3-4章に明記の
//      代替案（下記 SIMPLE FALLBACK コメントブロック）に切り替えてよい。その場合、reportCountの改ざん検知は
//      監視・運用担当の事後監査（通報履歴とreportCountの突合）に委ねる。

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 銘柄マスタ（design.md 4-1章）---
    // GitHub Actionsバッチ（firebase-admin SDK）のみが書き込む。Admin SDKはルールを経由しないため
    // 実質的に「クライアントからは書き込み不可、誰でも読み取り可」を意味する。
    match /stockMaster/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- チャット投稿（design.md 3-2〜3-4章 / 4-2章）---
    match /posts/{code} {
      // サマリドキュメント：誰でも読み取り可（トップ画面の注目銘柄表示用）。
      // messageCount/lastPostAtの更新はクライアントから許可するが、目安表示用の非厳密な値のため
      // 過度に厳格な検証はかけない（design.md 4-2章）。
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'name', 'messageCount', 'lastPostAt'])
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.messageCount is int;
      allow delete: if false; // 削除はGitHub Actionsバッチ（Admin SDK）のみが行う

      match /messages/{messageId} {
        allow read: if true;

        // 投稿作成（design.md 3-2章）
        // 【2026-09-12 追加】個人設定（表示名・アイコン）機能。authorName/authorIconは
        // 任意項目（未設定なら空文字）。表示名は最大20文字、アイコンは絵文字1文字分の
        // サイズ上限（サロゲートペア考慮で8文字分）までに制限し、悪用（過大な文字列の埋め込み）を防ぐ。
        // 【2026-09-13 追加】リアクション機能（likeCount）・連続投稿記録（streak）。
        // streakは投稿時点のクライアント算出値をそのまま信頼する（サーバー側での厳密な検証はしない。
        // 見た目上の演出要素であり、悪用されても実害が小さいためコストゼロ原則を優先）。
        allow create: if request.auth != null
          && request.resource.data.anonId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.reportCount == 0
          && request.resource.data.hidden == false
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 20
          && request.resource.data.authorIcon is string
          && request.resource.data.authorIcon.size() <= 8
          && request.resource.data.likeCount == 0
          && request.resource.data.streak is int;

        // 通報によるカウント更新（design.md 3-4章）／いいねのトグル（2026-09-13追加）
        // 【2026-09-12 統括リーダーによる修正】本番検証の結果、同一トランザクション内で直前に作成した
        // reports/{uid} ドキュメントを exists() が正しく参照できず、通報が「送信に失敗しました」で
        // 常に失敗する不具合を確認した。design.md 3-4章に申し送りされていたSIMPLE FALLBACK案に切り替える。
        // reportCount/hiddenのみ変更可能、reportCountは1件ずつしか増やせないことのみを検証し、
        // hiddenの整合性チェック・重複通報の検知はクライアント実装（utils/chat.jsのトランザクション、
        // および reports/{uid} をドキュメントIDにした構造）と運用担当の事後監査に委ねる。
        // いいねはlikeCountのみを±1する更新を許可する（likes/{uid}の作成・削除で重複防止）。
        allow update: if request.auth != null
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'hidden'])
              && request.resource.data.reportCount == resource.data.reportCount + 1
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
              // 【2026-09-13 修正】機能追加前に投稿された既存メッセージにはlikeCountフィールド自体が
              // 存在しないため、resource.data.likeCount + 1 は評価エラーとなり常に拒否されていた
              // （見た目上「いいねしても数字が増えない」不具合の原因）。get()でデフォルト値0を与えて回避する。
              && (
                request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1 ||
                request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
              )
            )
          );

        allow delete: if false; // 削除はGitHub Actionsバッチ（Admin SDK）のみが行う

        match /reports/{reporterUid} {
          allow create: if request.auth != null
            && request.auth.uid == reporterUid
            && request.resource.data.reason in ['defamation', 'spam', 'other']
            && request.resource.data.comment is string
            && request.resource.data.comment.size() <= 100
            && !exists(/databases/$(database)/documents/posts/$(code)/messages/$(messageId)/reports/$(reporterUid));
          allow read: if true;
          allow update, delete: if false;
        }

        // --- いいね（2026-09-13 追加）---
        // ドキュメントID＝いいねしたuidにすることで1ユーザー1投稿につき1いいねまでを構造的に保証する。
        // 通報とは異なり、いいねは取り消し（トグルオフ）できるようdeleteも本人にのみ許可する。
        match /likes/{likerUid} {
          allow create: if request.auth != null && request.auth.uid == likerUid;
          allow delete: if request.auth != null && request.auth.uid == likerUid;
          allow read: if true;
          allow update: if false;
        }
      }
    }

    // 上記以外は一切許可しない
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
